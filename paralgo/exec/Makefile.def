PARALGO_EXEC_BASE=exec
PARALGO_EXEC_DIR=$(PARALGO_DIR)/$(PARALGO_EXEC_BASE)
PARALGO_EXEC_PARTS= \
	$(PARALGO_EXEC_DIR)/*.tex

PARALGO_PARTS += $(PARALGO_EXEC_PARTS)

PARALGO_EXEC_PDF=$(PARALGO_DIR)-$(PARALGO_EXEC_BASE).pdf
PARALGO_EXEC_DOCX=$(PARALGO_DIR)-$(PARALGO_EXEC_BASE).docx

FINAL_PARALGO_EXEC_PDF=$(FINAL_DIR)/$(PARALGO_EXEC_PDF)
FINAL_PARALGO_EXEC_DOCX=$(FINAL_DIR)/$(PARALGO_EXEC_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_EXEC_PDF)