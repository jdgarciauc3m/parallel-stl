PARALGO_NUMERIC_BASE=numeric
PARALGO_NUMERIC_DIR=$(PARALGO_DIR)/$(PARALGO_NUMERIC_BASE)
PARALGO_NUMERIC_PARTS= \
	$(PARALGO_NUMERIC_DIR)/*.tex \

PARALGO_PARTS += $(PARALGO_NUMERIC_PARTS)

PARALGO_NUMERIC_PDF=$(PARALGO_DIR)-$(PARALGO_NUMERIC_BASE).pdf
PARALGO_NUMERIC_DOCX=$(PARALGO_DIR)-$(PARALGO_NUMERIC_BASE).docx

FINAL_PARALGO_NUMERIC_PDF=$(FINAL_DIR)/$(PARALGO_NUMERIC_PDF)
FINAL_PARALGO_NUMERIC_DOCX=$(FINAL_DIR)/$(PARALGO_NUMERIC_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_NUMERIC_PDF)