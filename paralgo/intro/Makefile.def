PARALGO_INTRO_BASE=intro
PARALGO_INTRO_DIR=$(PARALGO_DIR)/$(PARALGO_INTRO_BASE)
PARALGO_INTRO_PARTS= \
	$(PARALGO_INTRO_DIR)/*.tex

PARALGO_PARTS += $(PARALGO_INTRO_PARTS)

PARALGO_INTRO_PDF=$(PARALGO_DIR)-$(PARALGO_INTRO_BASE).pdf
PARALGO_INTRO_DOCX=$(PARALGO_DIR)-$(PARALGO_INTRO_BASE).docx

FINAL_PARALGO_INTRO_PDF=$(FINAL_DIR)/$(PARALGO_INTRO_PDF)
FINAL_PARALGO_INTRO_DOCX=$(FINAL_DIR)/$(PARALGO_INTRO_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_INTRO_PDF)