PARALGO_STL_BASE=stl
PARALGO_STL_DIR=$(PARALGO_DIR)/$(PARALGO_STL_BASE)
PARALGO_STL_PARTS= \
	$(PARALGO_STL_DIR)/*.tex

PARALGO_PARTS += $(PARALGO_STL_PARTS)

PARALGO_STL_PDF=$(PARALGO_DIR)-$(PARALGO_STL_BASE).pdf
PARALGO_STL_DOCX=$(PARALGO_DIR)-$(PARALGO_STL_BASE).docx

FINAL_PARALGO_STL_PDF=$(FINAL_DIR)/$(PARALGO_STL_PDF)
FINAL_PARALGO_STL_DOCX=$(FINAL_DIR)/$(PARALGO_STL_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_STL_PDF)