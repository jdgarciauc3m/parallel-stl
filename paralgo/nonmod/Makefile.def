PARALGO_NONMOD_BASE=nonmod
PARALGO_NONMOD_DIR=$(PARALGO_DIR)/$(PARALGO_NONMOD_BASE)
PARALGO_NONMOD_PARTS= \
	$(PARALGO_NONMOD_DIR)/*.tex

PARALGO_PARTS += $(PARALGO_NONMOD_PARTS)

PARALGO_NONMOD_PDF=$(PARALGO_DIR)-$(PARALGO_NONMOD_BASE).pdf
PARALGO_NONMOD_DOCX=$(PARALGO_DIR)-$(PARALGO_NONMOD_BASE).docx

FINAL_PARALGO_NONMOD_PDF=$(FINAL_DIR)/$(PARALGO_NONMOD_PDF)
FINAL_PARALGO_NONMOD_DOCX=$(FINAL_DIR)/$(PARALGO_NONMOD_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_NONMOD_PDF)