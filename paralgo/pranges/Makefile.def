PARALGO_PRANGES_BASE=pranges
PARALGO_PRANGES_DIR=$(PARALGO_DIR)/$(PARALGO_PRANGES_BASE)
PARALGO_PRANGES_PARTS= \
	$(PARALGO_PRANGES_DIR)/*.tex

PARALGO_PARTS += $(PARALGO_PRANGES_PARTS)

PARALGO_PRANGES_PDF=$(PARALGO_DIR)-$(PARALGO_PRANGES_BASE).pdf
PARALGO_PRANGES_DOCX=$(PARALGO_DIR)-$(PARALGO_PRANGES_BASE).docx

FINAL_PARALGO_PRANGES_PDF=$(FINAL_DIR)/$(PARALGO_PRANGES_PDF)
FINAL_PARALGO_PRANGES_DOCX=$(FINAL_DIR)/$(PARALGO_PRANGES_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARALGO_PRANGES_PDF)