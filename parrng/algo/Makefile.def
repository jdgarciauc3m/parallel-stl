PARRNG_ALGO_BASE=algo
PARRNG_ALGO_DIR=$(PARRNG_DIR)/$(PARRNG_ALGO_BASE)
PARRNG_ALGO_PARTS= \
	$(PARRNG_ALGO_DIR)/*.tex

PARRNG_PARTS += $(PARRNG_ALGO_PARTS)

PARRNG_ALGO_PDF=$(PARRNG_DIR)-$(PARRNG_ALGO_BASE).pdf
PARRNG_ALGO_DOCX=$(PARRNG_DIR)-$(PARRNG_ALGO_BASE).docx

FINAL_PARRNG_ALGO_PDF=$(FINAL_DIR)/$(PARRNG_ALGO_PDF)
FINAL_PARRNG_ALGO_DOCX=$(FINAL_DIR)/$(PARRNG_ALGO_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARRNG_ALGO_PDF)