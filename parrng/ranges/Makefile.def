PARRNG_RANGES_BASE=ranges
PARRNG_RANGES_DIR=$(PARRNG_DIR)/$(PARRNG_RANGES_BASE)
PARRNG_RANGES_PARTS= \
	$(PARRNG_RANGES_DIR)/*.tex

PARRNG_PARTS += $(PARRNG_RANGES_PARTS)

PARRNG_RANGES_PDF=$(PARRNG_DIR)-$(PARRNG_RANGES_BASE).pdf
PARRNG_RANGES_DOCX=$(PARRNG_DIR)-$(PARRNG_RANGES_BASE).docx

FINAL_PARRNG_RANGES_PDF=$(FINAL_DIR)/$(PARRNG_RANGES_PDF)
FINAL_PARRNG_RANGES_DOCX=$(FINAL_DIR)/$(PARRNG_RANGES_DOCX)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_PARRNG_RANGES_PDF)