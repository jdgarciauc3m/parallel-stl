CLASSICSTL_DIR=classicstl
CLASSICSTL_PARTS= \
	$(CLASSICSTL_DIR)/*.tex

# include $(CLASSICSTL_DIR)/iterator/Makefile.def

GUIDE_PARTS += $(CLASSICSTL_PARTS)

CLASSICSTL_PDF=$(CLASSICSTL_DIR).pdf
FINAL_CLASSICSTL_PDF=$(FINAL_DIR)/$(CLASSICSTL_PDF)

ALL_SLIDES_FINAL_PDF += \
	$(FINAL_CLASSICSTL_PDF)
